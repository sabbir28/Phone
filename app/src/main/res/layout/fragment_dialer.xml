<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:orientation="vertical">

    <!-- Title Row -->
    <LinearLayout
        android:id="@+id/dialerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvDialerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Keypad"
            android:textColor="@color/light_on_background"
            android:textSize="34sp"
            android:fontFamily="sans-serif-black" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_button"
            android:src="@drawable/ic_settings"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="@color/vibrant_blue" />
    </LinearLayout>

    <!-- Phone Number Display -->
    <EditText
        android:id="@+id/etPhoneNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:hint=""
        android:inputType="phone"
        android:minHeight="72dp"
        android:textAlignment="center"
        android:textColor="@color/light_on_background"
        android:textSize="44sp"
        android:fontFamily="sans-serif-light" />

    <!-- Glass Card for Dialpad -->
    <FrameLayout
        android:id="@+id/dialpadContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp">

        <View
            android:id="@+id/dialpadBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card" />

        <GridView
            android:id="@+id/dialpadGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:gravity="center"
            android:horizontalSpacing="12dp"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp" />
    </FrameLayout>

    <!-- Buttons Container -->
    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <!-- Call Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabCall"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Call"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/vibrant_green"
            app:cornerRadius="24dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_call"
            app:iconGravity="textStart"
            app:iconSize="28dp" />

        <!-- Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/glass_white"
            app:cornerRadius="24dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="@color/vibrant_red"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_stroke" />

    </LinearLayout>

</LinearLayout>