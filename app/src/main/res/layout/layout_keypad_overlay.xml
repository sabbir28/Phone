<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keypadOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_dark_bg"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <TextView
        android:id="@+id/tvKeypadTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Keypad"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDigitsDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:singleLine="true"
        android:ellipsize="start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvKeypadTitle" />

    <TableLayout
        android:id="@+id/tlKeypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:stretchColumns="*"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDigitsDisplay">

        <TableRow android:layout_marginBottom="16dp">
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf1" />
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf2" />
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf3" />
        </TableRow>

        <TableRow android:layout_marginBottom="16dp">
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf4" />
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf5" />
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf6" />
        </TableRow>

        <TableRow android:layout_marginBottom="16dp">
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf7" />
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf8" />
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf9" />
        </TableRow>

        <TableRow>
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmfStar" />
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmf0" />
            <include layout="@layout/item_dtmf_button" android:id="@+id/btnDtmfPound" />
        </TableRow>

    </TableLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHideKeypad"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginBottom="48dp"
        android:text="Hide"
        android:textColor="@color/ios_blue"
        android:textSize="18sp"
        app:backgroundTint="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
