<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Light Mode -->
    <style name="Theme.Phone" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/light_primary</item>
        <item name="colorPrimaryContainer">@color/light_primary_container</item>
        <item name="colorOnPrimary">@color/light_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/light_on_primary_container</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/light_secondary</item>
        <item name="colorSecondaryContainer">@color/light_secondary_container</item>
        <item name="colorOnSecondary">@color/light_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/light_on_secondary_container</item>
        
        <!-- Tertiary colors -->
        <item name="colorTertiary">@color/light_tertiary</item>
        <item name="colorTertiaryContainer">@color/light_tertiary_container</item>
        <item name="colorOnTertiary">@color/light_on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/light_on_tertiary_container</item>
        
        <!-- Background and surface colors -->
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorSurfaceVariant">@color/light_surface_variant</item>
        <item name="colorOnBackground">@color/light_on_background</item>
        <item name="colorOnSurface">@color/light_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/light_on_surface_variant</item>
        
        <!-- Outline colors -->
        <item name="colorOutline">@color/light_outline</item>
        <item name="colorOutlineVariant">@color/light_outline_variant</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/light_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Text appearances with Apple fonts -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Phone.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Phone.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Phone.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Phone.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Phone.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Phone.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Phone.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Phone.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Phone.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Phone.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Phone.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Phone.LabelSmall</item>
        
        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Phone.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Phone.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Phone.LargeComponent</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/light_background</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vibrant_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_call</item>
        <item name="postSplashScreenTheme">@style/Theme.Phone</item>
    </style>
    
    <!-- Shape Appearances -->
    <style name="ShapeAppearance.Phone.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    
    <style name="ShapeAppearance.Phone.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    
    <style name="ShapeAppearance.Phone.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Theme.Phone.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>