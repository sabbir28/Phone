<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Headline Styles -->
    <style name="TextAppearance.Phone.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">40sp</item>
    </style>
    
    <style name="TextAppearance.Phone.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">36sp</item>
    </style>
    
    <style name="TextAppearance.Phone.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">32sp</item>
    </style>
    
    <!-- Title Styles -->
    <style name="TextAppearance.Phone.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">28sp</item>
    </style>
    
    <style name="TextAppearance.Phone.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">24sp</item>
    </style>
    
    <style name="TextAppearance.Phone.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/sf_pro_rounded</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    
    <!-- Body Styles -->
    <style name="TextAppearance.Phone.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">24sp</item>
    </style>
    
    <style name="TextAppearance.Phone.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    
    <style name="TextAppearance.Phone.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineHeight">16sp</item>
    </style>
    
    <!-- Label Styles -->
    <style name="TextAppearance.Phone.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">16sp</item>
    </style>
    
    <style name="TextAppearance.Phone.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:lineHeight">16sp</item>
    </style>
    
    <style name="TextAppearance.Phone.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineHeight">16sp</item>
    </style>
</resources>
